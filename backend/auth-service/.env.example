# Copy to .env and adjust. .env is git-ignored.
PORT=3002

# Postgres from the repo's docker-compose.yml. Leave unset to use in-memory storage.
DATABASE_URL=postgres://chroniccare:chroniccare@localhost:5432/chroniccare_auth

# Signs access tokens. Must match JWT_SECRET in the services that verify tokens.
# At least 32 characters; use a long random value outside local development.
JWT_SECRET=local-development-secret-change-me-0123456789
JWT_EXPIRES_IN_SECONDS=3600

# Register and login attempts allowed per client per minute.
AUTH_RATE_LIMIT_PER_MINUTE=10

# Used only by `npm run test:int`.
TEST_DATABASE_URL=postgres://chroniccare:chroniccare@localhost:5432/chroniccare_auth_test
