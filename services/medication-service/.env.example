# Copy to .env and adjust. .env is git-ignored.
PORT=3001

# Postgres from the repo's docker-compose.yml. Leave unset to use in-memory storage.
DATABASE_URL=postgres://chroniccare:chroniccare@localhost:5432/chroniccare

# Used only by `npm run test:int`.
TEST_DATABASE_URL=postgres://chroniccare:chroniccare@localhost:5432/chroniccare_test
